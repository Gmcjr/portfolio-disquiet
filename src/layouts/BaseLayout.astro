---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
// Preload the body font so text does not reflow when it arrives (CLS).
import lektonRegularUrl from '@fontsource/lekton/files/lekton-latin-400-normal.woff2?url';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,
  initial-scale=1"
    />
    <title>{title}</title>
    <link
      rel="preload"
      href={lektonRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content="{title}" />
    <meta
      property="og:description"
      content="Disquiet – A portfolio showcasing design and development work."
    />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:url" content="https://example.com/" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Blocking on purpose: sets the theme before first paint. See public/theme.js. -->
    <script is:inline src="/theme.js"></script>
  </head>

  <body class="m-0 bg-bg text-text font-sans">
    <Header />
    <main class="snap-y snap-mandatory min-h-screen">
      <slot />
    </main>
    <ClientRouter />
  </body>
</html>
