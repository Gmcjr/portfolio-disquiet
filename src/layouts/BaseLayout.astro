---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
// Preload the body font so text does not reflow when it arrives (CLS).
import lektonRegularUrl from '@fontsource/lekton/files/lekton-latin-400-normal.woff2?url';

import { SITE_DESCRIPTION, SITE_NAME } from '../config/site';

interface Props {
  /** Page name. The layout appends the site name. Omit on the home page. */
  title?: string;
  /** Meta description for search results and social cards. */
  description?: string;
}

const { title } = Astro.props;
const description = Astro.props.description ?? SITE_DESCRIPTION;
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,
  initial-scale=1"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="preload"
      href={lektonRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <!-- No og:image yet: public/og-*.png are placeholders, not valid images. -->
    <link rel="icon" href="/favicon.ico" />
    <!-- Blocking on purpose: sets the theme before first paint. See public/theme.js. -->
    <script is:inline src="/theme.js"></script>
  </head>

  <body class="m-0 bg-bg text-text font-sans">
    <Header />
    <main class="snap-y snap-mandatory min-h-screen">
      <slot />
    </main>
    <ClientRouter />
  </body>
</html>
