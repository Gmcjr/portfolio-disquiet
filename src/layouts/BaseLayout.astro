---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
// Preload the body font so text does not reflow when it arrives (CLS).
import lektonRegularUrl from '@fontsource/lekton/files/lekton-latin-400-normal.woff2?url';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,
  initial-scale=1"
    />
    <title>{title}</title>
    <link
      rel="preload"
      href={lektonRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style>
      .kumar-one-outline-regular {
        font-family: 'Kumar One Outline', system-ui;
        font-weight: 400;
        font-style: normal;
      }
      .lekton-regular {
        font-family: 'Lekton', monospace;
        font-weight: 400;
        font-style: normal;
      }
      .lekton-bold {
        font-family: 'Lekton', monospace;
        font-weight: 700;
        font-style: normal;
      }
      .lekton-regular-italic {
        font-family: 'Lekton', monospace;
        font-weight: 400;
        font-style: italic;
      }
    </style>

    <meta property="og:title" content="{title}" />
    <meta
      property="og:description"
      content="Disquiet – A portfolio showcasing design and development work."
    />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:url" content="https://example.com/" />
    <link rel="icon" href="/favicon.ico" />
    <script>
      // Force light mode as default – runs before first paint
      (function () {
        if (typeof document === 'undefined') return;
        const theme = 'light';
        document.documentElement.dataset.theme = theme;
      })();

      // Re-run on client-side navigation (Astro view transitions) – enforce light
      document.addEventListener('astro:after-swap', function () {
        const theme = 'light';
        document.documentElement.dataset.theme = theme;
      });
    </script>
  </head>

  <body class="m-0 lekton-regular">
    <Header />
    <main class="snap-y snap-mandatory min-h-screen">
      <slot />
    </main>
    <ClientRouter />
  </body>
</html>
