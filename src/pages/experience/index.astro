---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/experience/Landing.astro';
import ExperienceRoot from '../../components/experience/ExperienceRoot.astro';
import DetourSketch from '../../components/experience/DetourSketch.astro';
import Exit from '../../components/experience/Exit.astro';
---

<BaseLayout title="Thank you for visiting" noindex>
  <ExperienceRoot>
    <Landing slot="landing" />
    <!-- Main experience content shows after seed is present -->
    <section class="w-full rounded-sm border-gray-300 focus:border-gray-500 focus:ring-2 focus:ring-gray-500 bg-transparent shadow-sm px-3 py-2">
      <DetourSketch />
      <Exit />
    </section>
  </ExperienceRoot>
</BaseLayout>
