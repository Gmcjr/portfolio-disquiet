---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllWork } from '../../lib/content';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getAllWork(import.meta.env.DEV);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} - Garrin Costa, Jr.`}>
  <main class="max-w-3xl mx-auto py-12 px-4 font-sans text-text">
    <h2 class="text-2xl font-heading">{entry.data.title}</h2>
    <div class="border p-4 rounded-sm text-xs text-gray-500 mt-2 mb-4">
      {entry.data.role} • {entry.data.year}
    </div>
    <article class="prose dark:prose-invert p-4">
      <Content />
    </article>
  </main>
</BaseLayout>
