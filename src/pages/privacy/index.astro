---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy — Disquiet">
  <main>
    <h1>Privacy</h1>
    <section>
      <h2>Analytics</h2>
      <p>
        This site uses{' '}
        <a
          href="https://www.goatcounter.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          GoatCounter
        </a>
        for anonymous, cookieless traffic statistics. No personal data is
        collected.
      </p>
    </section>
    <section>
      <h2>Contact form</h2>
      <p>
        When you submit the contact form, your name, email address, and message
        are sent to me via
        <a href="https://resend.com/" target="_blank" rel="noopener noreferrer">
          Resend
        </a>
        , a third‑party email service (US‑based). Resend processes and retains
        the message for up to 30 days to deliver it. The site does not store
        your message, and it is never used for anything other than replying to
        you.
      </p>
    </section>
  </main>
</BaseLayout>
