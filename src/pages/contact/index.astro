---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Contact — Disquiet">
  <main class="max-w-xl mx-auto py-12">
    <h1 class="text-3xl font-bold mb-6 text-center">Get in Touch</h1>

    <section class="bg-transparent dark:bg-transparent p-8 rounded-lg shadow-md">
      <form method="POST" action="/api/contact" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium mb-1">
            Name
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-sm border-gray-300 focus:border-gray-500 focus:ring-2 focus:ring-gray-500 bg-transparent shadow-sm px-3 py-2"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium mb-1">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-sm border-gray-300 focus:border-gray-500 focus:ring-2 focus:ring-gray-500 bg-transparent shadow-sm px-3 py-2"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium mb-1">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full rounded-sm border-gray-300 focus:border-gray-500 focus:ring-2 focus:ring-gray-500 bg-transparent shadow-sm px-3 py-2"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-transparent border border-gray-300 rounded-sm py-2"
        >
          Send Message
        </button>
      </form>
    </section>
  </main>
  <Footer />
</BaseLayout>
