---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSON_NAME, PERSON_ROLE } from '../config/site';
---

<BaseLayout title="About" description={`About ${PERSON_NAME}: ${PERSON_ROLE}.`}>
  <div class="max-w-3xl mx-auto py-12 px-4 font-sans text-text">
    <h1 class="text-3xl font-heading mb-4">About me</h1>
    <div class="w-full rounded-sm border-gray-300 focus:border-gray-500 focus:ring-2 focus:ring-gray-500 bg-transparent shadow-sm px-3 py-2">
      Garrin Costa, Jr. is a software engineer, audio engineer, music producer,
      sound designer, and musician.
    </div>
  </div>
</BaseLayout>
