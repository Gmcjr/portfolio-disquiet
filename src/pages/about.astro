---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PERSON_NAME, PERSON_ROLE } from '../config/site';
---

<BaseLayout title="About" description={`About ${PERSON_NAME}: ${PERSON_ROLE}.`}>
  <div class="max-w-3xl mx-auto py-12 px-4 font-sans text-text">
    <h1 class="text-3xl font-heading mb-4">About me</h1>
    <div class="space-y-4">
      <p>A portfolio of design and development work.</p>
      <p>
        Full-stack developer with 1,100+ hours of immersive training and
        production work in TypeScript, React, Node.js, PostgreSQL, Prisma, and
        Socket.IO. I build concurrency-aware services, real-time monitoring, and
        data-integrity workflows, and I am proficient with Claude Code, Pi
        Agent, and Hermes and enjoy exploring new technologies and concepts.
        Former audio engineer who brings calm troubleshooting, clear
        communication, and production discipline to collaborative software
        teams.
      </p>
    </div>
  </div>
</BaseLayout>
