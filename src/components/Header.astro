---
import ThemeToggle from '../components/ThemeToggle.astro';
import { NAV } from '../config/site';

// Only enabled sections render, so a reserved section never gets a dead link.
const links = NAV.filter((item) => item.enabled);
const path = Astro.url.pathname;
const isCurrent = (href: string): boolean =>
  path === href || path.startsWith(`${href}/`);
---

<header class="bg-bg shadow">
  <nav
    aria-label="Main"
    class="max-w-4xl mx-auto flex items-center justify-between p-4"
  >
    <a href="/" class="text-xl font-heading text-text">
      Disquiet
    </a>
    <div class="flex items-center space-x-4">
      {links.map((item) => (
        <a
          href={item.href}
          class="text-text"
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <ThemeToggle />
    </div>
  </nav>
</header>
