{
  "name": "disquiet",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src api --config",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "resend": "6.28.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/cli": "4.13.0",
    "@lhci/cli": "0.15.1",
    "dependency-cruiser": "18.3.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "jsdom": "30.0.1",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
