# Resend API key — server-only secret, never exposed to the client.
# Create one at https://resend.com/api-keys
# Local dev: use a test key; sends only deliver to your own Resend account address.
RESEND_API_KEY=

# Destination inbox for contact-form submissions.
# Local dev: your own email (Resend test mode only delivers to the account owner).
CONTACT_TO=

# The "from" address the contact function sends as.
# Local dev: onboarding@resend.dev (Resend's shared test sender — works with no domain setup)
# Production: an address on a domain you've verified with Resend.
CONTACT_FROM=onboarding@resend.dev